# MongoDB
MONGODB_URI=mongodb://localhost:27017/food-delivery

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Auth
AUTH_TOKEN_SECRET=replace_with_a_long_secret_min_32_chars
AUTH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_NAME=food_delivery_session

# Resend (email provider)
RESEND_API_KEY=
EMAIL_FROM=onboarding@example.com

# Redis (optional - required for background email queue)
REDIS_URL=redis://localhost:6379

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=
